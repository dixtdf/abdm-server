# =============================================================================
# Docker build context filter.
#
# Keep this list in sync with .gitignore: the image is built from a working
# copy, so anything generated locally must be excluded or it silently shadows
# the image's own build output.
# =============================================================================

# --- VCS ---------------------------------------------------------------------
.git
.gitignore
.github

# --- build outputs -----------------------------------------------------------
build/
**/build/
out/
bin/
dist/
*.class

# --- Gradle ------------------------------------------------------------------
.gradle/
**/.gradle/

# --- Node / web --------------------------------------------------------------
node_modules/
**/node_modules/
web/dist/
web/.vite/
web/coverage/
npm-debug.log*

# --- runtime data (never bake user state into an image) ----------------------
config/
data/
downloads/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- docs / editor / OS noise ------------------------------------------------
docs/
*.md
!README.md
# The frontend's i18n gate reads the error-code catalogue from docs/api.md inside
# the image's web stage, so that one file has to survive the filter.
!docs/api.md
!docs/upstream.md
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- upstream submodule + bridge -------------------------------------------
# The default image consumes exported runtime jars from the pinned submodule.
# Never send the upstream source tree or Gradle outputs to Docker.
third_party/ab-download-manager/
third_party/abdm-dist/*
!third_party/abdm-dist/.gitkeep
!third_party/abdm-dist/.abdm-pin
!third_party/abdm-dist/*.jar

# --- local secrets -----------------------------------------------------------
# Everything, including .env: compose interpolates it on the host, and baking
# it into a layer is exactly the accident this file exists to prevent.
.env
.env.*
