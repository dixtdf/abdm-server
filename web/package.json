{
  "name": "download-manager-web",
  "private": true,
  "version": "0.2.0",
  "description": "Web frontend for a self-hosted download manager. Independent project, not affiliated with AB Download Manager.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
